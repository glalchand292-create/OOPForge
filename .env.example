# OOPForge Environment Configuration (Copy to .env and backend/.env for local overrides)

# Backend server port
PORT=4000

# Set to "production" when hosting publicly
NODE_ENV=development

# SQLite database URL (relative to database/schema.prisma)
DATABASE_URL="file:./oopforge.db"

# Comma-separated browser origins allowed to call the backend API
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000"

# SECURITY WARNING:
# The built-in g++/clang++ runner executes code directly on the host OS.
# Keep "true" ONLY for local single-user study.
# Set "false" (or use Docker/nsjail/microVM isolation) before any public deployment!
ENABLE_LOCAL_CPP_SANDBOX="true"

# Optional custom path to C++17 compiler (defaults to g++ or clang++ on PATH)
CPP_COMPILER=""
