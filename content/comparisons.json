[
  {
    "id": "comp-1",
    "number": 1,
    "title": "Class vs Object",
    "topicId": "topic-1",
    "headers": [
      "Aspect",
      "Class",
      "Object"
    ],
    "rows": [
      [
        "**Nature**",
        "User-defined blueprint / type",
        "Concrete runtime instance of a class"
      ],
      [
        "**Memory**",
        "No per-object RAM allocated at definition",
        "Allocates `sizeof(Class)` bytes (stack/heap/static)"
      ],
      [
        "**Lifetime**",
        "Compile-time construct",
        "Runtime lifetime (constructor to destructor)"
      ],
      [
        "**Count**",
        "Defined once",
        "Zero, one, or millions of instances"
      ]
    ],
    "codeExample": "class Car { int speed = 0; }; // Blueprint (0 object bytes allocated)\nCar c1, c2;                   // Two distinct objects in memory",
    "note": ""
  },
  {
    "id": "comp-2",
    "number": 2,
    "title": "Encapsulation vs Abstraction",
    "topicId": "topic-4",
    "headers": [
      "Aspect",
      "Encapsulation",
      "Abstraction"
    ],
    "rows": [
      [
        "**Goal**",
        "**Data protection & bundling** (protect invariants)",
        "**Hiding complexity** (show *what*, hide *how*)"
      ],
      [
        "**Focus**",
        "Implementation-level (how internals are guarded)",
        "Design-level (clean external interface)"
      ],
      [
        "**C++ Tools**",
        "`private`/`protected` access specifiers + methods",
        "Abstract classes (`= 0`), headers, PIMPL"
      ],
      [
        "**Analogy**",
        "A medicine capsule sealing ingredients",
        "A car dashboard (pedals hide engine mechanics)"
      ]
    ],
    "codeExample": "class BankAccount {\n    double balance_ = 0;                 // Encapsulation (hidden state)\npublic:\n    virtual void pay(double amt) = 0;    // Abstraction (contract without details)\n};",
    "note": ""
  },
  {
    "id": "comp-3",
    "number": 3,
    "title": "Constructor vs Destructor",
    "topicId": "topic-6",
    "headers": [
      "Aspect",
      "Constructor",
      "Destructor"
    ],
    "rows": [
      [
        "**Purpose**",
        "Initialize object & acquire resources",
        "Clean up & release resources"
      ],
      [
        "**Name**",
        "`ClassName(...)`",
        "`~ClassName()`"
      ],
      [
        "**Overloading**",
        "Can be overloaded (multiple signatures)",
        "Cannot be overloaded (only one)"
      ],
      [
        "**Parameters**",
        "Can take parameters",
        "Takes zero parameters"
      ],
      [
        "**Virtual?**",
        "Never `virtual`",
        "Often `virtual` in polymorphic base classes"
      ],
      [
        "**Execution Order**",
        "Base -> Members -> Derived",
        "Derived -> Members -> Base (exact reverse)"
      ]
    ],
    "codeExample": "class Handle {\n    int* p_;\npublic:\n    Handle(int v) : p_(new int(v)) {} // Constructor acquires\n    ~Handle() { delete p_; }          // Destructor releases\n};",
    "note": ""
  },
  {
    "id": "comp-4",
    "number": 4,
    "title": "Constructor vs Copy Constructor",
    "topicId": "topic-7",
    "headers": [
      "Aspect",
      "Normal Constructor",
      "Copy Constructor"
    ],
    "rows": [
      [
        "**Syntax**",
        "`T()`, `T(int x)`",
        "`T(const T& other)`"
      ],
      [
        "**Input**",
        "Fresh arguments (or none)",
        "Existing object of the **same** class"
      ],
      [
        "**Compiler Default**",
        "Generated only if **no** constructors exist",
        "Generated unless suppressed (e.g. move ops declared)"
      ],
      [
        "**When Called**",
        "`T a(5);`",
        "`T b = a;`, pass-by-value, return-by-value (unless elided)"
      ]
    ],
    "codeExample": "struct Box {\n    int w;\n    Box(int x) : w(x) {}                   // Parameterized constructor\n    Box(const Box& o) : w(o.w) {}          // Copy constructor\n};",
    "note": ""
  },
  {
    "id": "comp-5",
    "number": 5,
    "title": "Copy Constructor vs Copy Assignment Operator",
    "topicId": "topic-7",
    "headers": [
      "Aspect",
      "Copy Constructor",
      "Copy Assignment Operator"
    ],
    "rows": [
      [
        "**Signature**",
        "`T(const T& other)`",
        "`T& operator=(const T& rhs)`"
      ],
      [
        "**Target State**",
        "Creates a **brand-new** object from scratch",
        "Overwrites an **already-existing** object"
      ],
      [
        "**Old Cleanup?**",
        "No prior resources to free",
        "Must free/reuse existing resources first"
      ],
      [
        "**Self-check?**",
        "Not needed (`this` is newly born)",
        "Must handle `a = a;` safely"
      ],
      [
        "**Trigger Syntax**",
        "`T b = a;` or `T b(a);`",
        "`b = a;` (after `b` already exists)"
      ]
    ],
    "codeExample": "Box a(10);\nBox b = a; // Calls Copy Constructor\nBox c(20);\nc = a;     // Calls Copy Assignment Operator",
    "note": ""
  },
  {
    "id": "comp-6",
    "number": 6,
    "title": "Shallow Copy vs Deep Copy",
    "topicId": "topic-1",
    "headers": [
      "Aspect",
      "Shallow Copy",
      "Deep Copy"
    ],
    "rows": [
      [
        "**Behavior**",
        "Copies member values directly (pointer address copied)",
        "Allocates new heap memory and copies pointed-to data"
      ],
      [
        "**Independence**",
        "Objects share the same heap block",
        "Objects are 100% independent"
      ],
      [
        "**Risk with Raw Ptrs**",
        "Aliasing mutation + Double-free UB",
        "Safe (each object owns & frees its own buffer)"
      ],
      [
        "**Default Compiler Copy**",
        "Memberwise (shallow for raw pointers)",
        "Must be written manually (or via `std::vector`/`std::string`)"
      ]
    ],
    "codeExample": "// Shallow: b.ptr = a.ptr; (both point to same int!)\n// Deep:    b.ptr = new int(*a.ptr); (separate heap ints)",
    "note": ""
  },
  {
    "id": "comp-7",
    "number": 7,
    "title": "Function Overloading vs Function Overriding",
    "topicId": "topic-16",
    "headers": [
      "Aspect",
      "Overloading",
      "Overriding"
    ],
    "rows": [
      [
        "**Scope**",
        "Same scope (same class or namespace)",
        "Base class and Derived class"
      ],
      [
        "**Signature**",
        "Same name, **different parameters**",
        "**Exact same** signature & `const`/ref-qualifiers"
      ],
      [
        "**`virtual` Needed?**",
        "No",
        "Yes (`Base` method must be `virtual`)"
      ],
      [
        "**Binding Time**",
        "Compile time (static)",
        "Runtime (dynamic via `vtable`, through `Base*`/`Base&`)"
      ],
      [
        "**Return Type**",
        "Can differ (if params differ)",
        "Must match (or be covariant pointer/ref)"
      ]
    ],
    "codeExample": "struct Base {\n    void f(int);                 // Overloaded with f(double)\n    void f(double);\n    virtual void g() const;      // Overridden in Derived\n};\nstruct Derived : Base {\n    void g() const override;\n};",
    "note": ""
  },
  {
    "id": "comp-8",
    "number": 8,
    "title": "Compile-Time Polymorphism vs Runtime Polymorphism",
    "topicId": "topic-18",
    "headers": [
      "Aspect",
      "Compile-Time Polymorphism",
      "Runtime Polymorphism"
    ],
    "rows": [
      [
        "**Mechanisms**",
        "Function/Operator Overloading, Templates, CRTP",
        "`virtual` functions + Inheritance + `Base*`/`Base&`"
      ],
      [
        "**Resolution**",
        "Decided by compiler at compile time",
        "Decided at runtime via `vptr` -> `vtable`"
      ],
      [
        "**Speed**",
        "Fastest (zero dispatch cost, inlinable)",
        "Slight cost (1 pointer indirection + `vptr` per object)"
      ],
      [
        "**Flexibility**",
        "Types must be known at compile time",
        "Handles heterogeneous containers at runtime"
      ]
    ],
    "codeExample": "template <typename T> T add(T a, T b) { return a + b; } // Compile-time\nvoid render(const Shape& s) { s.draw(); }              // Runtime (if draw is virtual)",
    "note": ""
  },
  {
    "id": "comp-9",
    "number": 9,
    "title": "Static Binding vs Dynamic Binding",
    "topicId": "topic-12",
    "headers": [
      "Aspect",
      "Static (Early) Binding",
      "Dynamic (Late) Binding"
    ],
    "rows": [
      [
        "**When Bound**",
        "Compile / link time",
        "Runtime"
      ],
      [
        "**Applies To**",
        "Non-virtual functions, overloaded calls, `static` methods, value calls `obj.f()`",
        "`virtual` functions called through `Base*` or `Base&`"
      ],
      [
        "**Default Arguments**",
        "Always statically bound!",
        "Function body dynamic, default arg STILL static!"
      ],
      [
        "**Overhead**",
        "Zero",
        "One vtable lookup"
      ]
    ],
    "codeExample": "Derived d;\nBase* p = &d;\np->nonVirtual(); // Static binding -> Base::nonVirtual()\np->isVirtual();  // Dynamic binding -> Derived::isVirtual()",
    "note": ""
  },
