    "headers": [
      "Aspect",
      "Object Slicing",
      "Polymorphism"
    ],
    "rows": [
      [
        "**How Passed / Stored**",
        "By **value** (`Base b = derived;`)",
        "By **pointer or reference** (`Base& b = derived;`)"
