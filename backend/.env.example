# OOPForge Backend Environment Variables (Copy to backend/.env)

PORT=4000
NODE_ENV=development
DATABASE_URL="file:./oopforge.db"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000"

# SECURITY WARNING: Local single-user host execution only.
# Automatically disabled when NODE_ENV=production unless replaced with a real VM/container runner.
ENABLE_LOCAL_CPP_SANDBOX="true"

CPP_COMPILER=""
