# Local SQLite database & personal progress (regenerate per developer)
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm
*.sqlite
*.sqlite3

# Generated C++ binaries & artifacts
*.exe
*.out
*.o
*.obj
*.pdb
*.ilk

# Temporary files & logs
tmp/
temp/
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
